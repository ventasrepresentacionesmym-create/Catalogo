<script>
function color(o){
 c = new Array('white','#ffcc80','#b8bfd8');
 t = 2 ;
 var s=o.style;
var x = s.backgroundColor;
 if (x=='') s.backgroundColor=c[0];
 var x = s.backgroundColor;
 for( i=0 ; i <= t ; i++ ){
  if( x == c[i] ){
   j=i+1;
   if (j>t) j=0;
   s.backgroundColor=c[j];
   i=t ;
  } 
 }
}
</script>
